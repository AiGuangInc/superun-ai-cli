{
  "name": "superun-ai-cli",
  "version": "0.1.4",
  "description": "superun-ai-cli 命令行工具，支持项目管理、对话创作、交互问答和应用发布",
  "author": "xiuyu.yi",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "superun-ai": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "dev": "npm run build --silent && node dist/development.js",
    "format": "prettier --write src package.json tsconfig.json",
    "format:check": "prettier --check src package.json tsconfig.json",
    "release": "bash scripts/release.sh",
    "prepack": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "commander": "14.0.0",
    "semver": "7.7.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  }
}
